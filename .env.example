# Copie para .env e defina PINs próprios (o arquivo .env não é versionado)
ECHO_PIN=
LUNA_PIN=

# Google Agenda: cliente OAuth de aplicativo web; consulte docs/google-agenda.md.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://echo.tfr-info.com.br/api/calendar/oauth/callback
# Chave base64 de 32 bytes. Nunca versionar a chave ou os tokens.
GOOGLE_CALENDAR_ENCRYPTION_KEY=

# Modo celular: segundo PIN (diferente do ECHO_PIN) para aprovar, negar e responder ao Claude Code.
# Sem ele, a aprovação pelo celular fica desativada.
ECHO_APPROVAL_PIN=
# Notificações push (par VAPID). Gerar uma vez: npx web-push generate-vapid-keys
ECHO_VAPID_PUBLIC_KEY=
ECHO_VAPID_PRIVATE_KEY=
ECHO_VAPID_SUBJECT=https://echo.tfr-info.com.br
# Endereço público do Echo, usado na checagem de origem das rotas do modo celular
ECHO_PUBLIC_ORIGIN=https://echo.tfr-info.com.br

# Localização compartilhada (chave base64 de 32 bytes; não versionar valores reais)
LOCATION_ENCRYPTION_KEY=
# Endereço da localização: OpenStreetMap por padrão (gratuito, sem chave); "off" desliga (nenhuma coordenada sai do servidor)
LOCATION_GEOCODING=
# Opcional: Google Geocoding no lugar do OpenStreetMap, com faturamento e chave restrita à API
LOCATION_GOOGLE_GEOCODING_KEY=
