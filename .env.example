# Copie para .env e defina PINs próprios (o arquivo .env não é versionado)
ECHO_PIN=
LUNA_PIN=

# Google Agenda: cliente OAuth de aplicativo web; consulte docs/google-agenda.md.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://echo.tfr-info.com.br/api/calendar/oauth/callback
# Chave base64 de 32 bytes. Nunca versionar a chave ou os tokens.
GOOGLE_CALENDAR_ENCRYPTION_KEY=

# Localização compartilhada (chave base64 de 32 bytes; não versionar valores reais)
LOCATION_ENCRYPTION_KEY=
# Opcional: Google Geocoding, com faturamento e chave restrita à API
LOCATION_GOOGLE_GEOCODING_KEY=
